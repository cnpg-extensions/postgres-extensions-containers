# BuildKit scans the builder, including recipe-owned source evidence.
ARG BUILDKIT_SBOM_SCAN_STAGE=builder
ARG BASE=ghcr.io/cloudnative-pg/postgresql:{{ .DefaultVersion }}-minimal-{{ .DefaultDistro }}
FROM ${BASE} AS builder

ARG PG_MAJOR={{ .DefaultVersion }}
ARG EXT_VERSION
ARG SOURCE_REPOSITORY
ARG SOURCE_REVISION
ARG TARGETARCH

USER 0
COPY source-build/ /source-build/

# TODO: Implement acquisition of the selected release and its pinned dependencies.
# acquire.py is recipe-owned; replace with inline acquisition if sufficient.
COPY universe/{{ .Name }}/acquire.py /recipe/acquire.py

# TODO: Install the tools and development libraries required by this recipe.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates python3 postgresql-server-dev-${PG_MAJOR} \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN python3 /recipe/acquire.py

# TODO: Use the selected release's documented compilation and install commands.
# Record that documentation URL here. Install under /install for payload staging.
# This placeholder must be replaced before building.
RUN echo 'TODO: implement upstream compilation and installation' >&2 && exit 1

# Keep timestamp-dependent evidence after compilation to preserve build caching.
ARG BUILD_TIMESTAMP
# TODO: Implement these recipe-owned files. There is no generic Universe
# dependency detector, payload stager or license collector. Stage /payload/lib,
# /payload/share/extension and /payload/licenses, including runtime dependencies.
# Preserve dpkg ownership for the shared generator; add bundled/static component
# evidence through its augment_spdx(document, context) hook, not a new composer.
COPY universe/{{ .Name }}/evidence.py universe/{{ .Name }}/augment_spdx.py /recipe/
RUN python3 /recipe/evidence.py \
    && install -D -m 0644 /recipe/augment_spdx.py /usr/local/share/cnpg-sbom/augment_spdx.py

FROM scratch
COPY --from=builder /payload/ /
USER 65532:65532
