{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "customManagers:githubActionsVersions",
    ":gitSignOff",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "ignorePaths": [],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "customManagers": [
    {
      "description": "Track Ubuntu runners in matrix values and runs-on expressions",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*runner:[ \\t]*['\"]?ubuntu-(?<currentValue>\\d+\\.\\d+(?:-arm)?)(?:['\"]|[ \\t\\r\\n]|$)",
        "(?:^|\\r?\\n)[ \\t]*runs-on:[ \\t]*\\$\\{\\{[^\\r\\n]*?['\"]ubuntu-(?<currentValue>\\d+\\.\\d+(?:-arm)?)['\"]"
      ],
      "depNameTemplate": "ubuntu",
      "depTypeTemplate": "github-runner",
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker"
    },
    {
      "description": "updates the deb package versions in the metadata.hcl files",
      "customType": "regex",
      "managerFilePatterns": [
        "**/*.hcl"
      ],
      "matchStrings": [
        "\\/\\/\\s*renovate:\\s*?(suite=(?<suite>.*?))?\\s*depName=(?<depName>.*?)?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s*(sql|package)\\s*=\\s*\"(?<currentValue>.*)\""
      ],
      "registryUrlTemplate": "https://download.postgresql.org/pub/repos/apt?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb"
    },
    {
      "description": "updates the container image versions in the README.md files",
      "customType": "regex",
      "managerFilePatterns": [
        "**/README.md"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*?(suite=(?<suite>.*?))?\\s*depName=(?<depName>.*?)?\\s*reference: ghcr.io\\/cnpg-extensions\\/[A-Za-z0-9_-]+:(?<currentValue>(?:[0-9]+-)?([0-9]\\.?)+)"
      ],
      "registryUrlTemplate": "https://download.postgresql.org/pub/repos/apt?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb",
      "currentValueTemplate": "{{{replace '-' ':' currentValue}}}",
      "extractVersionTemplate": "^(?<version>[^-+~]+)",
      "autoReplaceStringTemplate": "{{{replace (replace ':' '-' currentValue) (replace ':' '-' newValue) replaceString}}}"
    },
    {
      "description": "updates the container image SQL version in the README.md files",
      "customType": "regex",
      "managerFilePatterns": [
        "**/README.md"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*?(suite=(?<suite>.*?))?\\s*depName=(?<depName>.*?)?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s*version: '(?<currentValue>([0-9]\\.?)+)'"
      ],
      "registryUrlTemplate": "https://download.postgresql.org/pub/repos/apt?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb"
    },
    {
      "description": "updates the Taskfile, test files and GitHub Actions workflow dependencies",
      "customType": "regex",
      "managerFilePatterns": [
        "Taskfile.yml",
        ".github/workflows/*.yml",
        "**/test/*.yaml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: currentValue=(?<currentValue>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_SHA\\s*:\\s*[\"']?(?<currentDigest>[a-f0-9]+?)[\"']?\\s",
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[^:]+\\s*:\\s*[\"']?(?:[a-zA-Z0-9._\/-]+:)?(?<currentValue>[^@]+?)(@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?\\s"
      ]
    },
    {
      "description": "updates the dagger dependencies",
      "customType": "regex",
      "managerFilePatterns": [
        "dagger/**/*.go"
      ],
      "matchStrings": [
        "\\/\\/\\s+renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))\\s+\\/\\/\\s+\\+default=[\\\"']?[^:]+?:(?<currentValue>[^@]+?)(@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?\\s"
      ]
    },
    {
      "description": "updates the SBOM generator base image",
      "customType": "regex",
      "managerFilePatterns": [
        "sbom-generator/Dockerfile"
      ],
      "matchStrings": [
        "#\\s*renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: packageName=(?<packageName>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))?\\s+FROM\\s+(?:[a-zA-Z0-9._/-]+:)?(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]+))?"
      ]
    },
    {
      "description": "updates the SBOM generator Dockerfile frontend",
      "customType": "regex",
      "managerFilePatterns": [
        "sbom-generator/Dockerfile"
      ],
      "matchStrings": [
        "# syntax=docker/dockerfile:(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "docker/dockerfile",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "updates the SBOM generator tool versions",
      "customType": "regex",
      "managerFilePatterns": [
        "sbom-generator/Dockerfile"
      ],
      "matchStrings": [
        "#\\s*renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s+ARG [A-Z0-9_]+_VERSION=(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "description": "updates generator Debian packages not supplied by the base image",
      "customType": "regex",
      "managerFilePatterns": [
        "/^sbom-generator/dependencies/debian-(amd64|arm64)\\.txt$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9+.-]*)=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "deb"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "deb"
      ],
      "matchFileNames": [
        "sbom-generator/dependencies/debian-amd64.txt"
      ],
      "registryUrls": [
        "https://packages.debian.org/bookworm/amd64/{{packageName}}"
      ],
      "groupName": "SBOM generator Debian and base image updates",
      "description": "Work around Renovate #44330 using Debian package pages; see WORKAROUNDS.md",
      "overrideDatasource": "custom.debian-bookworm",
      "versioning": "deb"
    },
    {
      "matchDatasources": [
        "deb"
      ],
      "matchFileNames": [
        "sbom-generator/dependencies/debian-arm64.txt"
      ],
      "registryUrls": [
        "https://packages.debian.org/bookworm/arm64/{{packageName}}"
      ],
      "groupName": "SBOM generator Debian and base image updates",
      "description": "Work around Renovate #44330 using Debian package pages; see WORKAROUNDS.md",
      "overrideDatasource": "custom.debian-bookworm",
      "versioning": "deb"
    },
    {
      "description": "Hold SBOM Python to ScanCode-supported 3.14 Bookworm tags; see WORKAROUNDS.md",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python",
        "library/python"
      ],
      "matchFileNames": [
        "sbom-generator/Dockerfile"
      ],
      "groupName": "SBOM generator Debian and base image updates",
      "allowedVersions": "/^3\\.14(?:\\.\\d+)?-slim-bookworm$/"
    },
    {
      "description": "automerge checked latest generator digest updates",
      "matchPackageNames": [
        "/^ghcr\\.io\\/[^/]+\\/cnpg-sbom-generator$/"
      ],
      "groupName": "cnpg-sbom-generator image digests",
      "matchUpdateTypes": ["digest"],
      "matchCurrentValue": "latest",
      "automerge": true,
      "platformAutomerge": false,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "require stable release verification for extension updates",
      "matchDatasources": [
        "deb"
      ],
      "matchFileNames": [
        "*/metadata.hcl",
        "*/README.md"
      ],
      "matchRegistryUrls": [
        "https://download.postgresql.org/pub/repos/apt*"
      ],
      "prBodyNotes": [
        "⚠️ Before approving this PR, confirm that the new extension version is a stable release, not a beta or release candidate. The Automerge gate fails on added Renovate-tracked version lines containing `alpha`, `beta`, `rc`, or `~` (case-insensitive), except for the documented AGE naming exception. Manual approval alone does not clear a failed gate."
      ]
    },
    {
      "matchDatasources": [
        "github-tags"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "major",
        "minor",
        "patch"
      ],
      "groupName": "all github action",
      "pinDigests": true
    },
    {
      "description": "require SQL version review when no verified package mapping covers all shipped extensions",
      "matchPackageNames": [
        "postgresql-*-credcheck",
        "postgresql-*-jsquery",
        "postgresql-*-mysql-fdw",
        "postgresql-*-pg-csv",
        "postgresql-*-pglogical",
        "postgresql-*-pgmp",
        "postgresql-*-pgpcre",
        "postgresql-*-pgtt",
        "postgresql-*-pldebugger",
        "postgresql-*-pllua",
        "postgresql-*-plsh",
        "postgresql-*-prefix",
        "postgresql-*-preprepare",
        "postgresql-*-rdkit",
        "postgresql-*-similarity",
        "postgresql-*-stat-log",
        "postgresql-*-tablelog",
        "postgresql-*-toastinfo",
        "postgresql-pltcl-*"
      ],
      "automerge": false,
      "prBodyNotes": [
        "⚠️ SQL versions in this image cannot all be updated by a verified package-version extraction rule. Before merging, inspect every shipped extension control file and SQL upgrade script, including independently versioned bundled extensions. Update metadata.hcl, README.md and affected test expectations where needed. Do not infer SQL versions from the package version or approve solely because CI passed."
      ]
    },
    {
      "description": "Automerge non-major SBOM generator updates after all checks pass on the current base",
      "matchFileNames": [
        "sbom-generator/**",
        ".github/workflows/sbom-generator.yml"
      ],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "platformAutomerge": false,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Require manual merging for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Automerge minor and patch ScanCode releases after checks pass",
      "matchDatasources": [
        "pypi"
      ],
      "matchFileNames": [
        "sbom-generator/Dockerfile"
      ],
      "matchPackageNames": [
        "scancode-toolkit"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "ScanCode release and dependencies",
      "automerge": true,
      "prBodyNotes": [
        "The image build uses the selected ScanCode release's dependency constraints. On ARM64, pip selects compatible versions of the three native packages excluded from those constraints. Both native AMD64/ARM64 generator integration checks must pass before automerging. See WORKAROUNDS.md for packaging and ARM64 limitations."
      ],
      "platformAutomerge": false,
      "rebaseWhen": "behind-base-branch"
    }
  ],
  "customDatasources": {
    "debian-bookworm": {
      "format": "plain",
      "transformTemplates": [
        "($prefix := \"<h1>Package: {{{packageName}}} (\"; $headers := releases[$substring(version, 0, $length($prefix)) = $prefix]; $assert($count($headers) = 1, \"Expected one Debian package version heading\"); $archVersions := releases[$contains(version, \"<td class='vcurrent'>\")]; $assert($count($archVersions) <= 1, \"Expected at most one architecture version\"); $version := $count($archVersions) = 1 ? $substringBefore($substringAfter($archVersions[0].version, \">\"), \"<\") : $substringBefore($substringAfter($headers[0].version, $prefix), \")\"); $assert($contains($version, /^[0-9][0-9A-Za-z.+:~-]*$/), \"Invalid Debian package version\"); {\"releases\": [{\"version\": $version}]})"
      ]
    }
  }
}
