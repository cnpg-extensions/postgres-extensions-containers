metadata = {
  # TODO: Set the source repository and Cluster catalog name.
  # sql_name is the SQL extension name used by Database resources.
  build_system             = "pgrx"
  source_repository        = "https://github.com/<owner>/<repo>"
  name                     = "{{ .Name }}"
  sql_name                 = "{{ replaceAll .Name "-" "_" }}"

  # TODO: `image_name` must be unique in ghcr.io/cnpg-extensions.
  image_name               = "{{ .Name }}"

  # TODO: Use SPDX identifiers for the extension's primary license(s).
  licenses                 = ["Apache-2.0"]

  # TODO: Add only settings required for the extension to function.
  shared_preload_libraries = []
  postgresql_parameters    = {}
  extension_control_path   = []
  dynamic_library_path     = []
  ld_library_path          = []
  bin_path                 = []
  env                      = {}
  auto_update_os_libs      = false
  required_extensions      = []
  create_extension         = true

  // TODO: Keep package exactly equal to the upstream Git tag passed as
  // EXT_VERSION in Dockerfile, including any prefix or suffix. Do not apply
  // Debian epoch/version normalization to pgrx tags.
  versions = {
    {{- range $distro := .Distros}}
    {{ $distro }} = {
        {{- range $version := $.Versions}}
        "{{ $version }}" = {
          # TODO: Keep one Renovate github-tags comment on the source package
          # entry and configure its depName to match the upstream repository.
          # Keep package and sql adjacent: Renovate updates them together.
          # TODO: SQL version is the release tag without a leading v.
          # renovate: datasource=github-tags depName=<owner>/<repo> versioning=semver
          package = "<release-tag>"
          sql     = "<sql-version>"
        }
        {{- end}}
    }
    {{- end}}
  }
}
